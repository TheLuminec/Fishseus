      "tail": {
        "channel": 1,
        "invert": false,
        "forward_speed": 0,
        "reverse_speed": 0,
        "neutral_return_time": 0.02
      },
      "body": {
        "channel": 2,
        "invert": false,
        "forward_speed": 82,
        "reverse_speed": 25,
        "neutral_return_time": 0.02
      }
    }

{
  "audio": {
    "device": "plughw:3,0",
    "sample_rate": 16000,
    "channels": 1,
    "speech_threshold": 0.0262,
    "silence_threshold": 0.015,
    "silence_timeout_s": 1,
    "max_record_seconds": 12,
    "pre_roll_seconds": 0.4
  },
  "stt": {
    "whisper_binary": "./stt/whisper.cpp/build/bin/whisper-cli",
    "model_path": "./stt/whisper.cpp/models/ggml-base.en.bin",
    "threads": 4,
    "wake_words": [
      "fish",
      "fishseus",
      "hey fish"
    ],
    "strip_wake_word": false
  },
  "llm": {
    "provider": "xai",
    "temperature": 0.75,
    "max_tokens": 1024,
    "providers": {
      "ollama": {
        "api_type": "ollama",
        "disable_reasoning": false,
        "endpoint_url": "http://ollama.angelfish-gamma.ts.net/v1/chat/completions",
        "label": "Ollama (tailnet)",
        "model": "qwen2.5:3b"
      },
      "xai": {
        "api_key_env": "XAI_API_KEY",
        "api_type": "openai",
        "endpoint_url": "https://api.x.ai/v1/chat/completions",
        "label": "xAI Grok",
        "model": "grok-4.20-0309-non-reasoning"
      }
    }
  },
  "tts": {
    "piper_binary": "./tts/.venv/bin/piper",
    "voices_dir": "./tts/voices",
    "default_voice": "en_US-arctic-medium",
    "audio_device": "fishout",
    "output_dir": "../tmp/tts"
  },
  "motion": {
    "i2c_bus": 1,
    "i2c_address": 40,
    "auto_enable": true,
    "pwm_frequency": 1500,
    "body_wiggle_time": 0.17,
    "tail_wiggle_time": 0.18,
    "mouth_open_time": 0.1,
    "mouth_close_time": 0.02,
    "envelope_window_s": 0.25,
    "motors": {
      "mouth": {
        "channel": 3,
        "invert": true,
        "forward_speed": 40,
        "reverse_speed": 25,
        "neutral_return_time": 0.04
      },
      "tail": {
        "channel": 1,
        "invert": true,
        "forward_speed": 0,
        "reverse_speed": 0,
        "neutral_return_time": 0.02
      },
      "body": {
        "channel": 2,
        "invert": true,
        "forward_speed": 10,
        "reverse_speed": 10,
        "neutral_return_time": 0.02
      }
    }
  },
  "assistant": {
    "assistant_name": "Fishseus",
    "user_name": "User",
    "personality_path": "./config/personality_prompt.txt"
  },
  "vision": {
    "endpoint_url": "http://ollama.angelfish-gamma.ts.net/v1/chat/completions",
    "model": "qwen2.5vl:3b",
    "timeout_s": 120,
    "max_tokens": 300,
    "default_camera": "front",
    "cameras": {
      "front": {
        "command": "fswebcam -d /dev/video0 -r 1280x720 --no-banner {output}",
        "type": "command"
      }
    }
  },
  "sensors": {
    "enabled": false,
    "poll_interval_s": 0.05,
    "sensors": []
  },
  "web": {
    "bind_host": "127.0.0.1",
    "auth_enabled": true,
    "cf_access_team_domain": "avalontech0.cloudflareaccess.com",
    "cf_access_aud": "b678b2d431eba795bccd7c6516ea98daf1065e6a1f5ed15f9a37e44493c471e2",
    "local_bypass_token": "",
    "devices_cache_ttl_s": 60.0
  },
  "bluetooth": {
    "enabled": false,
    "default_speaker": "The JBL",
    "auto_connect": true,
    "scan_timeout_s": 10
  },
  "spotify": {
    "enabled": true,
    "device_name": "Fishseus",
    "redirect_uri": "http://127.0.0.1:8888/callback",
    "duck_mode": "volume",
    "duck_percent": 30
  },
  "access_point": {
    "enabled": false,
    "ssid": "Fishseus",
    "interface": "",
    "country_code": "US",
    "channel": 6,
    "address": "192.168.50.1",
    "prefix": 24,
    "dhcp_start": "192.168.50.50",
    "dhcp_end": "192.168.50.150",
    "dhcp_lease": "12h",
    "reserved": {
      "44:1b:f6:93:3e:50": "192.168.50.51",
      "44:1d:64:f5:e5:94": "192.168.50.52"
    },
    "stop_on_shutdown": false
  },
  "claude_link": {
    "enabled": true,
    "model": "",
    "timeout_s": 180.0
  }
}
